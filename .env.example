# ============================================================
# Asama.ai — environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Application ----
APP_NAME=Asama.ai API
APP_ENV=local
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# ---- PostgreSQL (Supabase) ----
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---- Redis (domain event stream) ----
REDIS_URL=redis://localhost:6379/0

# ---- RabbitMQ / Celery (background tasks) ----
RABBITMQ_URL=amqp://asama:asama_local_dev@localhost:5672//

# ---- Authentication (Phase 3) ----
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Agent credentials / webhook secrets (Phase 4) ----
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5

# ---- Embeddings & reranking (Phase 5) ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
RERANKER_PROVIDER=cohere
RERANKER_MODEL=
COHERE_API_KEY=

# ---- Routing defaults (Phase 5) ----
ROUTING_TOP_K=50
ROUTING_SCORE_THRESHOLD=0.75
ROUTING_MAX_RECIPIENTS=5

# ---- Local infrastructure (docker compose) ----
POSTGRES_USER=asama
POSTGRES_PASSWORD=asama_local_dev
POSTGRES_DB=asama
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
RABBITMQ_USER=asama
RABBITMQ_PASSWORD=asama_local_dev
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
